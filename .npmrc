# Always install devDependencies, even when NODE_ENV=production.
#
# The service sets NODE_ENV=production (it is what makes the session cookie
# Secure/SameSite=None for cross-site auth), and npm reads the same variable to
# decide whether to omit devDependencies. The compilers -- tsup and typescript --
# live there, so the install succeeded and the build then died with
# "tsup: not found" and exit 127.
#
# Setting it here rather than as a build-command flag means it holds whatever
# command the host happens to run.
include=dev
