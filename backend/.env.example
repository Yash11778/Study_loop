NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to call this API.
# Production: set to your Vercel URL, e.g. https://study-loop.vercel.app
CORS_ORIGINS=http://localhost:3000

# --- MongoDB Atlas. Must be Atlas, not a local mongod: the seed runs in a
#     transaction (needs a replica set) and retrieval uses Atlas Vector Search.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=study_loop

# --- Auth
JWT_SECRET=generate-with-openssl-rand-base64-32

# Require the emailed six-digit code as a second factor. Off by default: it can
# only work once mail actually reaches the student, and a shared sending domain
# delivers to the account owner alone, which locks everyone else out. Set to
# "true" once RESEND_FROM uses a domain you have verified.
REQUIRE_EMAIL_CODE=false

# --- Inference. Groq leads latency-sensitive tasks, Gemini leads long-context
#     ones, and each is the other's fallback. Gemini also serves embeddings --
#     Groq has no embedding endpoint at all.
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...
# Optional: override the chat model if Google retires the default for your
# project. `npm run doctor` lists what your key can actually reach.
GEMINI_MODEL=

# --- Delivery
RESEND_API_KEY=re_...
RESEND_FROM="Study Loop <onboarding@resend.dev>"

# --- Rate limiting. Unset is allowed in dev; the limiter no-ops and warns.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Guards the internal cron endpoints
CRON_SECRET=
