{
  "name": "adaptive-study-loop",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=shared && npm run build --workspace=backend && npm run build --workspace=frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed": "npm run seed --workspace=backend",
    "build:render": "npm run build --workspace=shared && npm run build --workspace=backend",
    "build:vercel": "npm run build --workspace=shared && npm run build --workspace=frontend",
    "doctor": "npm run doctor --workspace=backend",
    "indexes": "npm run indexes --workspace=backend",
    "seed:reset": "npm run seed:reset --workspace=backend",
    "e2e": "npm run e2e --workspace=backend",
    "browser-check": "node scripts/browser-check.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2"
  }
}
